{
  "ConnectionStrings": {
    "DVLDConnection": "Server=.;Database=DVLD;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "DVLD.Api",
    "Audience": "DVLD.Client",    
    "ExpirationMinutes": 15
  },
  "AuthSession": {
    "RefreshTokenLifetimeDays": 14,
    "IdleTimeoutDays": 7,
    "RotationGraceSeconds": 30,
    "RefreshCookieName": "dvld_rt",
    "RefreshCookiePath": "/api/Auth"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },
  "Seq": {
    "ServerUrl": "",
    "ApiKey": ""
  },
  "DiagnosticLogging": {
    "File": {
      "Enabled": false,
      "Path": "logs/dvld-.log",
      "RetainedFileCountLimit": 7,
      "FileSizeLimitBytes": 10485760
    }
  },
  "Storage": {
    "PersonImagesPath": "../DVLD_Storage/People"
  },
  "AllowedHosts": "*"
}
